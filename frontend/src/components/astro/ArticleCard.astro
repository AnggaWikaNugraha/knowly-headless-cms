---
import { mediaUrl } from '../../services/strapi/client';
import { formatDate } from '../../utils/date';
import type { Article } from '../../types/strapi';

interface Props { article: Article; }
const { article } = Astro.props;
const cover = mediaUrl(article.coverImage?.url);
const href = `/articles/${article.slug}`;
---
<!-- Gaya kartu mengikuti BlogCard portofolio: border-gray-700, bg-gray-900, rounded-lg -->
<article class="group flex flex-col overflow-hidden rounded-lg border border-gray-700 bg-gray-900 transition-colors hover:border-gray-600">
  <a href={href} class="block bg-gray-950">
    {cover ? (
      <img
        src={cover}
        alt={article.coverImage?.alternativeText ?? ''}
        width={article.coverImage?.width ?? 800}
        height={article.coverImage?.height ?? 450}
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="aspect-[16/9] w-full bg-gradient-to-br from-gray-800 to-gray-900" />
    )}
  </a>

  <div class="flex flex-1 flex-col gap-3 p-6">
    <div class="flex flex-wrap items-center gap-2 text-xs text-gray-400">
      {article.category && (
        <a href={`/categories/${article.category.slug}`} class="font-medium text-gray-300 hover:text-gray-50">
          {article.category.name}
        </a>
      )}
      <span aria-hidden="true">·</span>
      <time datetime={article.publishedAt ?? undefined}>{formatDate(article.publishedAt)}</time>
    </div>

    <h3 class="text-lg font-bold leading-snug text-gray-50">
      <a href={href} class="hover:underline">{article.title}</a>
    </h3>

    <p class="line-clamp-3 text-sm leading-relaxed text-gray-400">{article.excerpt}</p>
  </div>
</article>
