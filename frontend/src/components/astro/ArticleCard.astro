---
import { mediaUrl } from '../../services/strapi/client';
import { formatDate } from '../../utils/date';
import type { Article } from '../../types/strapi';

interface Props { article: Article; }
const { article } = Astro.props;
const cover = mediaUrl(article.coverImage?.url);
---
<article class="group flex flex-col gap-3">
  <a href={`/articles/${article.slug}`} class="block overflow-hidden rounded-lg bg-slate-100 dark:bg-slate-900">
    {cover ? (
      <img
        src={cover}
        alt={article.coverImage?.alternativeText ?? ''}
        width={article.coverImage?.width ?? 800}
        height={article.coverImage?.height ?? 450}
        loading="lazy"
        decoding="async"
        class="aspect-[16/9] w-full object-cover transition-transform duration-300 group-hover:scale-[1.02]"
      />
    ) : (
      <div class="aspect-[16/9] w-full bg-gradient-to-br from-slate-100 to-slate-200 dark:from-slate-900 dark:to-slate-800" />
    )}
  </a>

  <div class="flex flex-wrap items-center gap-2 text-xs text-slate-500 dark:text-slate-400">
    {article.category && (
      <a href={`/categories/${article.category.slug}`} class="font-medium text-slate-700 hover:underline dark:text-slate-300">
        {article.category.name}
      </a>
    )}
    <span aria-hidden="true">·</span>
    <time datetime={article.publishedAt ?? undefined}>{formatDate(article.publishedAt)}</time>
  </div>

  <h3 class="text-lg font-semibold leading-snug text-slate-900 dark:text-slate-100">
    <a href={`/articles/${article.slug}`} class="hover:underline">{article.title}</a>
  </h3>

  <p class="line-clamp-3 text-sm leading-relaxed text-slate-600 dark:text-slate-400">{article.excerpt}</p>
</article>
