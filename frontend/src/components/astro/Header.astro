---
import { site, nav } from '../../config/site';
const path = Astro.url.pathname;
---
<header class="border-b border-gray-800">
  <div class="mx-auto flex max-w-5xl items-center justify-between px-4 py-5">
    <a href="/" class="text-lg font-bold tracking-tight text-gray-50">{site.name}</a>
    <nav class="flex gap-6 text-sm">
      {nav.map(({ label, href }) => (
        <a
          href={href}
          class:list={[
            'transition-colors hover:text-gray-50',
            path.startsWith(href) ? 'font-medium text-gray-50' : 'text-gray-400',
          ]}
        >
          {label}
        </a>
      ))}
    </nav>
  </div>
</header>
