---
/**
 * Membungkus HTML artikel yang sudah dirender.
 *
 * Menerima HTML jadi, bukan Markdown mentah, supaya halaman pemanggil bisa
 * memakai daftar heading dari proses render yang sama — kalau dirender dua
 * kali, `id` heading berisiko tidak sinkron dengan daftar isi.
 *
 * `set:html` aman di sini: isinya dari CMS milik sendiri yang hanya bisa
 * ditulis editor terautentikasi, bukan input pengunjung.
 */
interface Props { html: string; }
const { html } = Astro.props;
---
<div class="prose-knowly" set:html={html} />
