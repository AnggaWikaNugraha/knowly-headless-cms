---
/** Navigasi halaman berbasis tautan biasa — bisa di-crawl, jalan tanpa JavaScript. */
interface Props {
  currentPage: number;
  lastPage: number;
  prevUrl?: string;
  nextUrl?: string;
}
const { currentPage, lastPage, prevUrl, nextUrl } = Astro.props;
const base = 'pagination-link';
const active = '';
const muted = 'is-disabled';
---
{lastPage > 1 && (
  <nav class="pagination" aria-label="Navigasi halaman">
    {prevUrl
      ? <a href={prevUrl} class:list={[base, active]}>← Sebelumnya</a>
      : <span class:list={[base, muted]} aria-disabled="true">← Sebelumnya</span>}
    <span class="text-sm text-gray-400">Halaman {currentPage} dari {lastPage}</span>
    {nextUrl
      ? <a href={nextUrl} class:list={[base, active]}>Berikutnya →</a>
      : <span class:list={[base, muted]} aria-disabled="true">Berikutnya →</span>}
  </nav>
)}
