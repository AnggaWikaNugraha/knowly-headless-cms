---
import { getCategories } from '../../services/strapi/categories';
import type { Category } from '../../types/strapi';

let categories: Category[] = [];
try {
  categories = (await getCategories()).items;
} catch {
  categories = [];
}

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Beranda', icon: 'home' },
  { href: '/articles', label: 'Artikel', icon: 'doc' },
  { href: '/search', label: 'Cari', icon: 'search' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<nav class="feed-nav" aria-label="Navigasi blog">
  {links.map(({ href, label, icon }) => (
    <a
      href={href}
      aria-current={isActive(href) ? 'page' : undefined}
      class:list={['feed-nav-link', { 'is-active': isActive(href) }]}
    >
      <svg class="h-6 w-6 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.4" aria-hidden="true">
        {icon === 'home' && <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" stroke-linejoin="round" />}
        {icon === 'doc' && <path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M8 13h8M8 17h5" stroke-linejoin="round" stroke-linecap="round" />}
        {icon === 'search' && <path d="M11 19a8 8 0 1 1 0-16 8 8 0 0 1 0 16zM21 21l-4.3-4.3" stroke-linecap="round" />}
      </svg>
      {label}
    </a>
  ))}

  {categories.length > 0 && (
    <div class="feed-nav-section">
      <p class="feed-nav-label">Jelajahi kategori</p>
      {categories.map((c) => (
        <a
          href={`/categories/${c.slug}`}
          aria-current={path === `/categories/${c.slug}` ? 'page' : undefined}
          class:list={['feed-category-link', { 'is-active': path === `/categories/${c.slug}` }]}
        >
          <span class="category-mark" aria-hidden="true">{c.name.charAt(0)}</span>
          <span>{c.name}</span>
        </a>
      ))}
    </div>
  )}
</nav>
