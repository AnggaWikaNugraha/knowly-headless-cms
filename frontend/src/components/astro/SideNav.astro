---
import { getCategories } from '../../services/strapi/categories';
import type { Category } from '../../types/strapi';

let categories: Category[] = [];
try {
  categories = (await getCategories()).items;
} catch {
  categories = [];
}

const path = Astro.url.pathname;
const links = [
  { href: '/', label: 'Beranda', icon: 'home' },
  { href: '/articles', label: 'Artikel', icon: 'doc' },
];
const isActive = (href: string) => (href === '/' ? path === '/' : path.startsWith(href));
---
<nav class="space-y-1 text-sm">
  {links.map(({ href, label, icon }) => (
    <a
      href={href}
      class:list={[
        'flex items-center gap-3 rounded-md px-3 py-2 transition-colors',
        isActive(href) ? 'bg-gray-800/60 text-gray-50' : 'text-gray-400 hover:bg-gray-800/40 hover:text-gray-100',
      ]}
    >
      <svg class="h-4 w-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" aria-hidden="true">
        {icon === 'home'
          ? <path d="M3 10.5 12 3l9 7.5V20a1 1 0 0 1-1 1h-5v-6H9v6H4a1 1 0 0 1-1-1z" stroke-linejoin="round" />
          : <path d="M6 3h8l4 4v14a1 1 0 0 1-1 1H6a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zM14 3v5h5M8 13h8M8 17h5" stroke-linejoin="round" stroke-linecap="round" />}
      </svg>
      {label}
    </a>
  ))}

  {categories.length > 0 && (
    <div class="pt-6">
      <p class="px-3 pb-2 text-xs font-semibold uppercase tracking-[0.15em] text-gray-600">Kategori</p>
      {categories.map((c) => (
        <a
          href={`/categories/${c.slug}`}
          class:list={[
            'block truncate rounded-md px-3 py-2 transition-colors',
            path === `/categories/${c.slug}`
              ? 'bg-gray-800/60 text-gray-50'
              : 'text-gray-400 hover:bg-gray-800/40 hover:text-gray-100',
          ]}
        >
          {c.name}
        </a>
      ))}
    </div>
  )}
</nav>
