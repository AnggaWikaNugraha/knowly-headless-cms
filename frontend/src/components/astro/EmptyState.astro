---
interface Props { title: string; description?: string; }
const { title, description } = Astro.props;
---
<div class="rounded-lg border border-dashed border-slate-300 px-6 py-16 text-center dark:border-slate-700">
  <p class="font-medium text-slate-900 dark:text-slate-100">{title}</p>
  {description && <p class="mt-2 text-sm text-slate-500 dark:text-slate-400">{description}</p>}
</div>
