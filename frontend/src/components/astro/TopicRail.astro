---
import { getTags } from '../../services/strapi/tags';
import type { Tag } from '../../types/strapi';
import { site } from '../../config/site';

let tags: Tag[] = [];
try {
  tags = (await getTags(12)).items;
} catch {
  tags = [];
}
---
{tags.length > 0 && (
  <section class="topic-section">
    <h2>Jelajahi topik</h2>
    <ul class="topic-list">
      {tags.map((t) => (
        <li>
          <a
            href={`/tags/${t.slug}`}
            class="topic-link"
          >
            {t.name}
          </a>
        </li>
      ))}
    </ul>
    <a href="/articles" class="rail-more">Lihat semua artikel <span aria-hidden="true">↗</span></a>
  </section>
)}
<div class="rail-about">
  <a href="/" class="rail-brand">{site.name}</a>
  <p>{site.tagline}.</p>
  <div class="rail-footer"><a href="/articles">Artikel</a><a href="/search">Pencarian</a><span>© {new Date().getFullYear()} {site.name}</span></div>
</div>
