---
import { getTags } from '../../services/strapi/tags';
import type { Tag } from '../../types/strapi';

let tags: Tag[] = [];
try {
  tags = (await getTags(12)).items;
} catch {
  tags = [];
}
---
{tags.length > 0 && (
  <aside class="space-y-4">
    <h2 class="text-base font-bold text-gray-100">Topik</h2>
    <ul class="flex flex-wrap gap-2">
      {tags.map((t) => (
        <li>
          <a
            href={`/tags/${t.slug}`}
            class="inline-block rounded-full bg-gray-800/70 px-3 py-1.5 text-sm text-gray-400 transition-colors hover:bg-gray-700 hover:text-gray-100"
          >
            {t.name}
          </a>
        </li>
      ))}
    </ul>
  </aside>
)}
