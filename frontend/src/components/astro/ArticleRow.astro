---
import { mediaUrl } from '../../services/strapi/client';
import { formatDate, readingTime } from '../../utils/date';
import type { Article } from '../../types/strapi';

interface Props { article: Article; }
const { article } = Astro.props;
const href = `/articles/${article.slug}`;
const thumb = mediaUrl(article.coverImage?.url);
const avatar = mediaUrl(article.author?.avatar?.url);
---
<article class:list={['story-row', { 'story-row--with-image': !!thumb }]}>
  <div class="story-byline">
    {article.author && (
      <a href={`/authors/${article.author.slug}`} class="story-author">
        <span class="story-avatar">
          {article.author.name.charAt(0)}
          {avatar && <img src={avatar} alt="" width="24" height="24" loading="lazy" onerror="this.remove()" />}
        </span>
        <span>{article.author.name}</span>
      </a>
    )}
    {article.author && article.publishedAt && <span aria-hidden="true">·</span>}
    {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
  </div>
  <div class="story-copy">
    <h2 class="story-title"><a href={href}>{article.title}</a></h2>
    <p class="story-excerpt">{article.excerpt}</p>
  </div>
  {thumb && (
    <a href={href} class="story-thumbnail" tabindex="-1" aria-hidden="true">
      <img src={thumb} alt="" width="240" height="160" loading="lazy" decoding="async" onerror="this.closest('article').classList.remove('story-row--with-image');this.closest('a').remove()" />
    </a>
  )}
  <div class="story-footer">
    <div class="story-details">
      {article.category && <a href={`/categories/${article.category.slug}`} class="story-category">{article.category.name}</a>}
      <span>{readingTime(article.content)} menit baca</span>
    </div>
    <a href={href} class="story-read" aria-label={`Baca ${article.title}`} title="Baca artikel">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M5 12h14m-6-6 6 6-6 6" /></svg>
    </a>
  </div>
</article>
