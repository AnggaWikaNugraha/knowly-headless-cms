---
/**
 * Ditampilkan saat Strapi tidak bisa dihubungi.
 * Tidak memuat detail teknis — pesan internal tidak boleh sampai ke pengunjung.
 */
interface Props { title?: string; }
const { title = 'Konten sedang tidak bisa dimuat' } = Astro.props;
---
<div class="feed-state state-panel" role="status">
  <span class="state-symbol" aria-hidden="true">↻</span>
  <strong>{title}</strong>
  <p>Silakan coba lagi beberapa saat lagi.</p>
  <a href={Astro.url.pathname + Astro.url.search} class="text-link">Coba lagi <span aria-hidden="true">↗</span></a>
</div>
