---
/**
 * Ditampilkan saat Strapi tidak bisa dihubungi.
 * Tidak memuat detail teknis — pesan internal tidak boleh sampai ke pengunjung.
 */
interface Props { title?: string; }
const { title = 'Konten sedang tidak bisa dimuat' } = Astro.props;
---
<div class="rounded-lg border border-amber-800/60 bg-amber-950/40 px-6 py-12 text-center">
  <p class="font-medium text-amber-200">{title}</p>
  <p class="mt-2 text-sm text-amber-300/70">Silakan coba lagi beberapa saat lagi.</p>
</div>
