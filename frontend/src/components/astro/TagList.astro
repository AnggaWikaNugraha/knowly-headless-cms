---
import type { Tag } from '../../types/strapi';
interface Props { tags: Tag[]; }
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag.slug}`}
          class="inline-block rounded-full border border-slate-200 px-3 py-1 text-xs text-slate-600 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-200"
        >
          {tag.name}
        </a>
      </li>
    ))}
  </ul>
)}
