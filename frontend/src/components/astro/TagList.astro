---
import type { Tag } from '../../types/strapi';
interface Props { tags: Tag[]; }
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag.slug}`}
          class="inline-block rounded bg-gray-800 px-2 py-1 text-xs text-gray-400 transition-colors hover:bg-gray-700 hover:text-gray-100"
        >
          #{tag.name}
        </a>
      </li>
    ))}
  </ul>
)}
