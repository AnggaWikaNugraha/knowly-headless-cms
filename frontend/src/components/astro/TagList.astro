---
import type { Tag } from '../../types/strapi';
interface Props { tags: Tag[]; }
const { tags } = Astro.props;
---
{tags.length > 0 && (
  <ul class="flex flex-wrap gap-2">
    {tags.map((tag) => (
      <li>
        <a
          href={`/tags/${tag.slug}`}
          class="topic-link"
        >
          #{tag.name}
        </a>
      </li>
    ))}
  </ul>
)}
