---
import { mediaUrl } from '../../services/strapi/client';
import { formatDate } from '../../utils/date';
import type { Article } from '../../types/strapi';
interface Props { article: Article; }
const { article } = Astro.props;
const cover = mediaUrl(article.coverImage?.url);
const href = `/articles/${article.slug}`;
---
<article class="featured-story">
  <div class="featured-topline"><span class="eyebrow">Pilihan bacaan</span><span aria-hidden="true">↗</span></div>
  {cover && (
    <a href={href} class="featured-image" tabindex="-1" aria-hidden="true">
      <img src={cover} alt="" width={article.coverImage?.width ?? 1200} height={article.coverImage?.height ?? 630} loading="eager" decoding="async" onerror="this.closest('a').remove()" />
    </a>
  )}
  <div class="featured-copy">
    <div class="story-byline">
      {article.category && <a href={`/categories/${article.category.slug}`} class="story-category">{article.category.name}</a>}
      {article.publishedAt && <time datetime={article.publishedAt}>{formatDate(article.publishedAt)}</time>}
    </div>
    <h2><a href={href}>{article.title}</a></h2>
    <p>{article.excerpt}</p>
    <div class="featured-footer">
      {article.author && <a class="story-author" href={`/authors/${article.author.slug}`}><span class="story-avatar">{article.author.name.charAt(0)}</span>{article.author.name}</a>}
      <a href={href} class="text-link">Baca cerita <span aria-hidden="true">↗</span></a>
    </div>
  </div>
</article>
