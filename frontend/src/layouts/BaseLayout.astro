---
import '../styles/global.css';
import BaseHead from '../components/astro/BaseHead.astro';
import SideRail from '../components/astro/SideRail.astro';
import SideNav from '../components/astro/SideNav.astro';
import TopicRail from '../components/astro/TopicRail.astro';
import { site } from '../config/site';

interface Props {
  title: string;
  description: string;
  image?: string | null;
  canonical?: string | null;
  keywords?: string | null;
  /**
   * feed    — tiga kolom bergaya Medium (nav kiri, daftar, rail topik)
   * article — dua kolom: badan artikel + rail daftar isi
   * plain   — satu kolom sempit
   */
  layout?: 'feed' | 'article' | 'plain';
  article?: {
    publishedAt: string | null;
    updatedAt: string;
    author?: string | null;
    category?: string | null;
    tags?: string[];
  } | null;
}

const { layout = 'plain', ...head } = Astro.props;
---
<!doctype html>
<html lang={site.lang} class="scroll-smooth">
  <head>
    <BaseHead {...head} />
  </head>
  <body class="flex min-h-screen flex-col antialiased">
    <a href="#main-content" class="skip-link">Langsung ke konten</a>
    <SideRail />

    <div class="site-shell flex min-h-screen flex-col">
      <main id="main-content" class:list={['flex-1 bg-gradient-to-b from-gray-900 to-gray-800', layout === 'feed' ? 'feed-main' : 'reading-main']}>
      {layout === 'feed' && (
        <div class="feed-layout">
          <aside class="feed-navigation"><div class="feed-sticky"><SideNav /></div></aside>
          <div class="feed-content"><slot /></div>
          <aside class="feed-topics"><div class="feed-sticky"><TopicRail /></div></aside>
        </div>
      )}

      {layout === 'article' && (
        <div class="mx-auto grid max-w-5xl gap-12 lg:grid-cols-[minmax(0,42rem)_14rem]">
          <div class="min-w-0"><slot /></div>
          {/*
            Rail ini sengaja TIDAK diberi `hidden` di layar kecil. Bilah progres
            di dalam island berposisi fixed, dan elemen fixed di dalam ancestor
            `display:none` tidak dirender sama sekali. Yang disembunyikan di
            layar sempit cukup daftar isinya, diatur dari dalam komponennya.
          */}
          <aside class="lg:block"><div class="sticky top-8"><slot name="rail" /></div></aside>
        </div>
      )}

      {layout === 'plain' && <div class="mx-auto max-w-3xl"><slot /></div>}
      </main>

    </div>
  </body>
</html>
