---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="Halaman tidak ditemukan" description={`Halaman yang kamu cari tidak ada di ${site.name}.`}>
  <div class="py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-400 dark:text-slate-600">404</p>
    <h1 class="mt-3 text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">
      Halaman tidak ditemukan
    </h1>
    <p class="mx-auto mt-4 max-w-md text-slate-600 dark:text-slate-400">
      Tautannya mungkin salah, atau artikelnya sudah dipindahkan.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-md border border-slate-300 px-4 py-2 text-sm text-slate-700 transition-colors hover:border-slate-500 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">
        Beranda
      </a>
      <a href="/articles" class="rounded-md border border-slate-300 px-4 py-2 text-sm text-slate-700 transition-colors hover:border-slate-500 dark:border-slate-700 dark:text-slate-300 dark:hover:border-slate-500">
        Semua artikel
      </a>
    </div>
  </div>
</BaseLayout>
