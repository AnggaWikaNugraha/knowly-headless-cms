---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="Halaman tidak ditemukan" description={`Halaman yang kamu cari tidak ada di ${site.name}.`}>
  <div class="py-20 text-center">
    <p class="text-sm font-semibold uppercase tracking-wider text-gray-500">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-50">
      Halaman tidak ditemukan
    </h1>
    <p class="mx-auto mt-4 max-w-md text-gray-400">
      Tautannya mungkin salah, atau artikelnya sudah dipindahkan.
    </p>
    <div class="mt-8 flex justify-center gap-3">
      <a href="/" class="rounded-md border border-gray-700 px-4 py-2 text-sm text-gray-300 transition-colors hover:border-gray-500">
        Beranda
      </a>
      <a href="/articles" class="rounded-md border border-gray-700 px-4 py-2 text-sm text-gray-300 transition-colors hover:border-gray-500">
        Semua artikel
      </a>
    </div>
  </div>
</BaseLayout>
