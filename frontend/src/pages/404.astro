---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="Halaman tidak ditemukan" description={`Halaman yang kamu cari tidak ada di ${site.name}.`}>
  <div class="not-found">
    <p class="error-number">404</p>
    <h1 class="mt-3 text-3xl font-bold tracking-tight text-gray-50">
      Sepertinya kita tersesat.
    </h1>
    <p class="mx-auto mt-4 max-w-md text-gray-400">
      Tautannya mungkin salah, atau artikelnya sudah dipindahkan.
    </p>
    <div class="error-actions">
      <a href="/" class="button-link">
        Beranda
      </a>
      <a href="/articles" class="button-link button-secondary">
        Semua artikel
      </a>
    </div>
  </div>
</BaseLayout>
