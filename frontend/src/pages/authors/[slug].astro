---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/astro/ArticleList.astro';
import EmptyState from '../../components/astro/EmptyState.astro';
import { getAuthors, getAuthorBySlug } from '../../services/strapi/authors';
import { getArticlesByAuthor } from '../../services/strapi/articles';
import { mediaUrl } from '../../services/strapi/client';

export const getStaticPaths: GetStaticPaths = async () => {
  const { items } = await getAuthors();
  return items.map((a) => ({ params: { slug: a.slug } }));
};

const { slug } = Astro.params;
const author = await getAuthorBySlug(slug!);
if (!author) return Astro.redirect('/404');

const { items: articles, pagination } = await getArticlesByAuthor(author.slug, 1, 100);
const avatar = mediaUrl(author.avatar?.url);
---
<BaseLayout title={author.name} description={author.bio ?? `Artikel oleh ${author.name}.`} image={avatar} feed>
  <header class="mb-12 flex items-start gap-5 border-b border-gray-700 pb-8">
    {avatar && (
      <img src={avatar} alt={author.avatar?.alternativeText ?? author.name} width="72" height="72"
           class="h-18 w-18 rounded-full object-cover" />
    )}
    <div>
      <p class="text-sm font-semibold uppercase tracking-wider text-gray-400">Penulis</p>
      <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-50">{author.name}</h1>
      {author.bio && <p class="mt-3 max-w-xl text-gray-400">{author.bio}</p>}
      <p class="mt-3 text-sm text-gray-400">{pagination.total} artikel</p>
    </div>
  </header>

  {articles.length > 0
    ? <ArticleList articles={articles} />
    : <EmptyState title="Penulis ini belum punya artikel" />}
</BaseLayout>
