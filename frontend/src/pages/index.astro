---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleList from '../components/astro/ArticleList.astro';
import FeedTabs from '../components/astro/FeedTabs.astro';
import EmptyState from '../components/astro/EmptyState.astro';
import ErrorState from '../components/astro/ErrorState.astro';
import { getFeaturedArticles, getLatestArticles } from '../services/strapi/articles';
import { site } from '../config/site';
import type { Article } from '../types/strapi';

let hero: Article | null = null;
let others: Article[] = [];
let failed = false;

try {
  hero = (await getFeaturedArticles(1)).items[0] ?? null;

  // Kecualikan hero, kalau tidak artikel yang sama muncul dua kali di halaman ini.
  others = (await getLatestArticles(8, hero ? [hero.documentId] : [])).items;

  if (!hero && others.length > 0) {
    hero = others[0];
    others = others.slice(1);
  }
} catch {
  failed = true;
}
---
<BaseLayout title={site.name} description={site.description} layout="feed">
  <header class="feed-heading">
    <h1>Ruang untuk <span class="heading-muted">ide baru.</span></h1>
    <p>{site.tagline}.</p>
  </header>
  <FeedTabs />

  {failed && <ErrorState />}

  {!failed && hero && (
    <ArticleList articles={[hero, ...others]} />
  )}

  {!failed && !hero && (
    <EmptyState title="Belum ada tulisan" description="Artikel yang diterbitkan akan muncul di sini." />
  )}

</BaseLayout>
