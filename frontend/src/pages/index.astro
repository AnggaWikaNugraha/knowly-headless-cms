---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleGrid from '../components/astro/ArticleGrid.astro';
import EmptyState from '../components/astro/EmptyState.astro';
import ErrorState from '../components/astro/ErrorState.astro';
import { getFeaturedArticles, getLatestArticles } from '../services/strapi/articles';
import { getCategories } from '../services/strapi/categories';
import { getTags } from '../services/strapi/tags';
import { site } from '../config/site';
import type { Article, Category, Tag } from '../types/strapi';

let featured: Article[] = [];
let latest: Article[] = [];
let categories: Category[] = [];
let tags: Tag[] = [];
let failed = false;

try {
  const [f, l, c, t] = await Promise.all([
    getFeaturedArticles(2),
    getLatestArticles(6),
    getCategories(),
    getTags(8),
  ]);
  featured = f.items;
  latest = l.items;
  categories = c.items;
  tags = t.items;
} catch {
  failed = true;
}
---
<BaseLayout title={site.name} description={site.description}>
  <section class="mb-16 border-b border-slate-200 pb-12 dark:border-slate-800">
    <h1 class="max-w-2xl text-3xl font-semibold leading-tight tracking-tight text-slate-900 sm:text-4xl dark:text-slate-100">
      {site.tagline}
    </h1>
    <p class="mt-4 max-w-xl text-slate-600 dark:text-slate-400">{site.description}</p>
  </section>

  {failed && <ErrorState />}

  {!failed && featured.length > 0 && (
    <section class="mb-20">
      <h2 class="mb-8 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Pilihan</h2>
      <ArticleGrid articles={featured} />
    </section>
  )}

  {!failed && (
    <section>
      <div class="mb-8 flex items-baseline justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Terbaru</h2>
        <a href="/articles" class="text-sm text-slate-600 hover:underline dark:text-slate-400">Semua artikel →</a>
      </div>
      {latest.length > 0
        ? <ArticleGrid articles={latest} />
        : <EmptyState title="Belum ada artikel" description="Konten yang diterbitkan akan muncul di sini." />}
    </section>
  )}

  {!failed && categories.length > 0 && (
    <section class="mt-20 border-t border-slate-200 pt-12 dark:border-slate-800">
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Kategori</h2>
      <div class="grid gap-6 sm:grid-cols-3">
        {categories.map((c) => (
          <a href={`/categories/${c.slug}`} class="group rounded-lg border border-slate-200 p-5 transition-colors hover:border-slate-400 dark:border-slate-800 dark:hover:border-slate-600">
            <h3 class="font-medium text-slate-900 dark:text-slate-100">{c.name}</h3>
            {c.description && <p class="mt-1 text-sm text-slate-500 dark:text-slate-400">{c.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {!failed && tags.length > 0 && (
    <section class="mt-16">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Topik populer</h2>
      <ul class="flex flex-wrap gap-2">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${t.slug}`} class="inline-block rounded-full border border-slate-200 px-3 py-1 text-sm text-slate-600 transition-colors hover:border-slate-400 hover:text-slate-900 dark:border-slate-800 dark:text-slate-400 dark:hover:border-slate-600 dark:hover:text-slate-200">
              {t.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
