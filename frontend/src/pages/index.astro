---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleGrid from '../components/astro/ArticleGrid.astro';
import EmptyState from '../components/astro/EmptyState.astro';
import ErrorState from '../components/astro/ErrorState.astro';
import { getFeaturedArticles, getLatestArticles } from '../services/strapi/articles';
import { getCategories } from '../services/strapi/categories';
import { getTags } from '../services/strapi/tags';
import { site } from '../config/site';
import type { Article, Category, Tag } from '../types/strapi';

let featured: Article[] = [];
let latest: Article[] = [];
let categories: Category[] = [];
let tags: Tag[] = [];
let failed = false;

try {
  const [f, l, c, t] = await Promise.all([
    getFeaturedArticles(2), getLatestArticles(6), getCategories(), getTags(8),
  ]);
  featured = f.items; latest = l.items; categories = c.items; tags = t.items;
} catch {
  failed = true;
}
---
<BaseLayout title={site.name} description={site.description}>
  <section class="mb-14 border-b border-gray-700 pb-10">
    <h1 class="max-w-2xl text-3xl font-bold leading-tight tracking-tight text-gray-50 sm:text-4xl">
      {site.tagline}
    </h1>
    <p class="mt-4 max-w-xl text-gray-400">{site.description}</p>
  </section>

  {failed && <ErrorState />}

  {!failed && featured.length > 0 && (
    <section class="mb-16">
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-gray-400">Pilihan</h2>
      <ArticleGrid articles={featured} />
    </section>
  )}

  {!failed && (
    <section>
      <div class="mb-6 flex items-baseline justify-between">
        <h2 class="text-sm font-semibold uppercase tracking-wider text-gray-400">Terbaru</h2>
        <a href="/articles" class="text-sm text-gray-400 hover:text-gray-50">Semua artikel →</a>
      </div>
      {latest.length > 0
        ? <ArticleGrid articles={latest} />
        : <EmptyState title="Belum ada artikel" description="Konten yang diterbitkan akan muncul di sini." />}
    </section>
  )}

  {!failed && categories.length > 0 && (
    <section class="mt-16 border-t border-gray-700 pt-10">
      <h2 class="mb-6 text-sm font-semibold uppercase tracking-wider text-gray-400">Kategori</h2>
      <div class="grid gap-4 sm:grid-cols-3">
        {categories.map((c) => (
          <a href={`/categories/${c.slug}`} class="rounded-lg border border-gray-700 bg-gray-900 p-5 transition-colors hover:border-gray-600">
            <h3 class="font-bold text-gray-50">{c.name}</h3>
            {c.description && <p class="mt-1 text-sm text-gray-400">{c.description}</p>}
          </a>
        ))}
      </div>
    </section>
  )}

  {!failed && tags.length > 0 && (
    <section class="mt-12">
      <h2 class="mb-4 text-sm font-semibold uppercase tracking-wider text-gray-400">Topik populer</h2>
      <ul class="flex flex-wrap gap-2">
        {tags.map((t) => (
          <li>
            <a href={`/tags/${t.slug}`} class="inline-block rounded bg-gray-800 px-3 py-1 text-sm text-gray-400 transition-colors hover:bg-gray-700 hover:text-gray-100">
              #{t.name}
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}
</BaseLayout>
