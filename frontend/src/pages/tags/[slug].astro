---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleGrid from '../../components/astro/ArticleGrid.astro';
import EmptyState from '../../components/astro/EmptyState.astro';
import { getTags, getTagBySlug } from '../../services/strapi/tags';
import { getArticlesByTag } from '../../services/strapi/articles';

export const getStaticPaths: GetStaticPaths = async () => {
  const { items } = await getTags();
  return items.map((t) => ({ params: { slug: t.slug } }));
};

const { slug } = Astro.params;
const tag = await getTagBySlug(slug!);
if (!tag) return Astro.redirect('/404');

const { items: articles, pagination } = await getArticlesByTag(tag.slug, 1, 100);
---
<BaseLayout title={`Tag: ${tag.name}`} description={`Artikel dengan tag ${tag.name}.`}>
  <header class="mb-12 border-b border-slate-200 pb-8 dark:border-slate-800">
    <p class="text-sm font-semibold uppercase tracking-wider text-slate-500 dark:text-slate-400">Tag</p>
    <h1 class="mt-2 text-3xl font-semibold tracking-tight text-slate-900 dark:text-slate-100">{tag.name}</h1>
    <p class="mt-3 text-sm text-slate-500 dark:text-slate-400">{pagination.total} artikel</p>
  </header>

  {articles.length > 0
    ? <ArticleGrid articles={articles} />
    : <EmptyState title="Belum ada artikel dengan tag ini" />}
</BaseLayout>
