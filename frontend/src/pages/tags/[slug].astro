---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleList from '../../components/astro/ArticleList.astro';
import EmptyState from '../../components/astro/EmptyState.astro';
import { getTags, getTagBySlug } from '../../services/strapi/tags';
import { getArticlesByTag } from '../../services/strapi/articles';

export const getStaticPaths: GetStaticPaths = async () => {
  const { items } = await getTags();
  return items.map((t) => ({ params: { slug: t.slug } }));
};

const { slug } = Astro.params;
const tag = await getTagBySlug(slug!);
if (!tag) return Astro.redirect('/404');

const { items: articles, pagination } = await getArticlesByTag(tag.slug, 1, 100);
---
<BaseLayout title={`Tag: ${tag.name}`} description={`Artikel dengan tag ${tag.name}.`} layout="feed">
  <header class="feed-heading">
    <p class="text-sm font-semibold uppercase tracking-wider text-gray-400">Tag</p>
    <h1 class="mt-2 text-3xl font-bold tracking-tight text-gray-50">{tag.name}</h1>
    <p class="mt-3 text-sm text-gray-400">{pagination.total} artikel</p>
  </header>

  {articles.length > 0
    ? <ArticleList articles={articles} />
    : <EmptyState title="Belum ada artikel dengan tag ini" />}
</BaseLayout>
