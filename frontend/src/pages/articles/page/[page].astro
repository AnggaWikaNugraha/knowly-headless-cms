---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import PageHeading from '../../../components/astro/PageHeading.astro';
import ArticleList from '../../../components/astro/ArticleList.astro';
import EmptyState from '../../../components/astro/EmptyState.astro';
import Pagination from '../../../components/astro/Pagination.astro';
import { getArticles } from '../../../services/strapi/articles';
import { site } from '../../../config/site';

/**
 * Halaman 2 ke atas. Halaman 1 ada di /articles.
 *
 * Pagination sengaja tidak memakai [...page] di dalam /articles/, karena rest
 * route di sana menyapu seluruh /articles/* dan menelan /articles/<slug>.
 */
export const getStaticPaths: GetStaticPaths = async () => {
  const { pagination } = await getArticles(1, site.pageSize);
  const paths = [];
  for (let p = 2; p <= pagination.pageCount; p += 1) {
    paths.push({ params: { page: String(p) } });
  }
  return paths;
};

const current = Number(Astro.params.page);
const { items, pagination } = await getArticles(current, site.pageSize);
---
<BaseLayout title={`Artikel — halaman ${current}`} description={`Semua artikel di ${site.name}.`} layout="feed">
  <PageHeading eyebrow={`Arsip / Halaman ${current}`} title="Masih banyak cerita." description="Lanjutkan penjelajahanmu, satu tulisan pada satu waktu." count={pagination.total} />

  {items.length > 0
    ? <ArticleList articles={items} />
    : <EmptyState title="Belum ada artikel di halaman ini" />}

  <Pagination
    currentPage={current}
    lastPage={pagination.pageCount}
    prevUrl={current === 2 ? '/articles' : `/articles/page/${current - 1}`}
    nextUrl={current < pagination.pageCount ? `/articles/page/${current + 1}` : undefined}
  />
</BaseLayout>
