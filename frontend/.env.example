# Strapi REST API — server-side only, tanpa prefix PUBLIC_ agar tidak bocor ke browser
# Tanpa token: akses baca dibuka untuk role Public (lihat D3 di docs/ARCHITECTURE.md)
STRAPI_API_URL=http://localhost:1337

# URL publik situs — dipakai canonical URL dan tag Open Graph
PUBLIC_SITE_URL=http://localhost:4321
