# Strapi REST API — server-side only, tanpa prefix PUBLIC_ agar tidak bocor ke browser
# Tanpa token: akses baca dibuka untuk role Public (lihat D3 di docs/ARCHITECTURE.md)
STRAPI_API_URL=http://localhost:1337

# Backend produksi tidur saat menganggur; request pertama harus membangunkannya.
# Naikkan timeout di environment build (Vercel) — mis. 30000 dengan 2 kali ulang.
STRAPI_TIMEOUT_MS=15000
STRAPI_RETRIES=2

# URL publik situs — dipakai canonical URL dan tag Open Graph
PUBLIC_SITE_URL=http://localhost:4321

# Portofolio tempat Knowly akan disajikan sebagai /blogs.
# Diisi selama Knowly berdiri sendiri, supaya rail navigasi mengarah ke
# portofolio yang sudah live. Dikosongkan setelah rewrite /blogs aktif —
# saat itu tautan relatif justru yang benar.
PUBLIC_PORTFOLIO_URL=https://port-tau-azure.vercel.app
